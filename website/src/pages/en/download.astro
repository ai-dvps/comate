---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
---

<BaseLayout title="Download Comate — macOS, Windows, and Linux" description="Download the Comate general-purpose Agent task workspace. macOS, Windows, and Linux builds are published through the official GitHub Releases page.">
  <Nav><LanguagePicker slot="language-picker" /><LanguagePicker slot="language-picker-mobile" /></Nav>
  <main class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <DownloadPanel locale="en" />
    <div class="reveal mt-8 grid gap-6 md:grid-cols-2">
      <section class="rounded-2xl border border-border bg-surface p-6">
        <h2 class="text-xl font-semibold text-text-primary">Installation</h2>
        <ol class="mt-4 list-decimal space-y-3 pl-5 leading-7 text-text-secondary">
          <li>Choose the installer for your platform and processor on the official GitHub Releases page.</li>
          <li>Follow that release’s instructions to install and start Comate.</li>
          <li>Create a Workspace and draft Session; configure model credentials or a Provider before running an Agent.</li>
        </ol>
      </section>
      <section class="rounded-2xl border border-border bg-surface p-6">
        <h2 class="text-xl font-semibold text-text-primary">Before you download</h2>
        <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-text-secondary">
          <li>macOS: choose the build for Apple silicon or Intel Mac.</li>
          <li>Windows: use a supported 64-bit Windows system.</li>
          <li>Linux: x64 AppImage and Debian packages are available.</li>
          <li>Follow the current compatibility and installation notes for that release.</li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
