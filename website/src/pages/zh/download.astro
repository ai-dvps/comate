---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
---

<BaseLayout title="下载 Comate — macOS、Windows 与 Linux" description="下载 Comate 通用 Agent 任务工作区。macOS、Windows 和 Linux 版本均通过官方 GitHub Releases 发布。">
  <Nav><LanguagePicker slot="language-picker" /><LanguagePicker slot="language-picker-mobile" /></Nav>
  <main class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <DownloadPanel locale="zh" />
    <div class="reveal mt-8 grid gap-6 md:grid-cols-2">
      <section class="rounded-2xl border border-border bg-surface p-6">
        <h2 class="text-xl font-semibold text-text-primary">安装步骤</h2>
        <ol class="mt-4 list-decimal space-y-3 pl-5 leading-7 text-text-secondary">
          <li>在官方 GitHub Releases 中选择与你的平台和处理器匹配的安装包。</li>
          <li>按照该版本的说明安装并启动 Comate。</li>
          <li>创建工作区和草稿会话；运行 Agent 前，按设置指南配置模型凭据或 Provider。</li>
        </ol>
      </section>
      <section class="rounded-2xl border border-border bg-surface p-6">
        <h2 class="text-xl font-semibold text-text-primary">下载前确认</h2>
        <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-text-secondary">
          <li>macOS：选择 Apple 芯片或 Intel Mac 对应的安装包。</li>
          <li>Windows：使用受支持的 64 位 Windows 系统。</li>
          <li>Linux：提供 x64 AppImage 与 Debian 软件包。</li>
          <li>以对应版本说明中的当前兼容性和安装要求为准。</li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
