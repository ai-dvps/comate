---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocalizedEntries, type Lang } from '../i18n/utils.js';
import { providerPrerequisite } from '../lib/site-facts.js';
import ProductEvidence from './ProductEvidence.astro';

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const allEntries = await getCollection('usage');
const entries = getLocalizedEntries(allEntries, locale).sort((a, b) => a.data.step - b.data.step);
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { id: entry.id, data: entry.data, Content };
  })
);
---

<main class="mx-auto max-w-3xl px-4 py-16 md:py-24">
  <h1 class="text-4xl font-bold text-text-primary md:text-5xl">
    {locale === 'zh' ? '使用方法' : 'Usage'}
  </h1>
  <p class="mt-4 max-w-2xl text-lg text-text-secondary">
    {locale === 'zh'
      ? '从选择安装包、配置模型 Provider，到完成并复核第一个任务。'
      : 'From choosing an installer and configuring a model Provider to completing and reviewing your first task.'}
  </p>

  <aside class="mt-8 rounded-xl border border-accent/30 bg-accent/5 p-5" data-provider-disclosure="usage">
    <h2 class="font-semibold text-text-primary">{locale === 'zh' ? '先了解执行前提' : 'Know the execution prerequisite'}</h2>
    <p class="mt-2 text-sm leading-6 text-text-secondary">{providerPrerequisite.disclosure[locale]}</p>
  </aside>

  <ol class="mt-12 space-y-8">
    {
      rendered.map(({ id, data, Content }, index) => (
        <li
          id={data.step === 2 ? 'provider-setup' : undefined}
          class="relative scroll-mt-24 rounded-lg border border-border bg-surface p-6"
          data-usage-step
          data-usage-step-number={data.step}
          data-content-id={id}
        >
          <span class="absolute -top-3 left-6 inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent text-sm font-semibold text-accent-foreground">
            {index + 1}
          </span>
          <h2 class="text-xl font-semibold text-text-primary">{data.title}</h2>
          <div class="prose mt-3 max-w-none text-text-secondary">
            <Content />
          </div>
        </li>
      ))
    }
  </ol>

  <ProductEvidence locale={locale} variant="usage" />

  <div class="mt-12 rounded-2xl border border-border bg-surface p-7 text-center">
    <h2 class="text-2xl font-semibold text-text-primary">{locale === 'zh' ? '准备开始？' : 'Ready to begin?'}</h2>
    <p class="mx-auto mt-2 max-w-xl text-text-secondary">{locale === 'zh' ? '先选择适合当前设备的安装包，再按以上顺序完成配置。' : 'Choose the installer for this device, then follow the setup sequence above.'}</p>
    <a
      href={getRelativeLocaleUrl(locale, '/download/')}
      data-analytics-event="download_cta_click"
      data-analytics-locale={locale}
      data-analytics-location="usage_closing"
      data-analytics-platform="all"
      data-analytics-stage="download_page"
      class="mt-5 inline-flex min-h-12 items-center justify-center rounded-lg bg-conversion px-7 py-3 font-semibold text-conversion-foreground no-underline shadow-sm shadow-conversion/20 hover:bg-conversion-hover"
    >{locale === 'zh' ? '前往下载' : 'Go to Download'}</a>
  </div>
</main>
