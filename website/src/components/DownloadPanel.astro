---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { platformFacts, providerPrerequisite, releaseDestination } from '../lib/site-facts.js';
import { useTranslations, type Lang } from '../i18n/utils.js';

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const releasesUrl = releaseDestination.url;
const providerSetupUrl = `${getRelativeLocaleUrl(locale, '/usage/')}#provider-setup`;
---

<section class="rounded-2xl border border-border bg-surface p-6 shadow-sm md:p-8" aria-labelledby="download-headline">
  <div class="max-w-3xl space-y-2">
    <p class="text-sm font-semibold text-accent">{t('download.latestVersion')}</p>
    <h1 class="text-3xl font-bold text-text-primary md:text-5xl" id="download-headline">{t('download.headline')}</h1>
    <p class="text-base leading-7 text-text-secondary md:text-lg">{t('download.description')}</p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-3" data-platform-options>
    {
      platformFacts.map((platform, index) => (
        <article class="relative flex min-h-full flex-col rounded-xl border border-border bg-bg p-5 transition-colors" data-platform-card={platform.key} data-recommended="false">
          <span class="mb-3 hidden w-fit rounded-full bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent" data-platform-recommended>
            {t('download.recommended')}
          </span>
          <h2 class="text-xl font-semibold text-text-primary">{platform.label[locale]}</h2>
          <p class="mt-2 grow text-sm leading-6 text-text-secondary">{platform.requirement[locale]}</p>
          <p class="mt-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">{platform.artifactKinds.join(' · ')}</p>
          <a
            href={releasesUrl}
            data-platform-download={platform.key}
            data-analytics-event="release_download_click"
            data-analytics-locale={locale}
            data-analytics-location={index === 0 ? 'download_primary' : 'download_secondary'}
            data-analytics-platform={platform.key}
            data-analytics-stage="github_releases"
            class="mt-5 inline-flex min-h-12 items-center justify-center rounded-lg bg-conversion px-4 py-3 text-center text-sm font-semibold text-conversion-foreground no-underline shadow-sm shadow-conversion/20 hover:bg-conversion-hover focus-visible:ring-2 focus-visible:ring-conversion focus-visible:ring-offset-2"
          >
            {t(`download.${platform.key}` as 'download.macos' | 'download.windows' | 'download.linux')}
          </a>
        </article>
      ))
    }
  </div>

  <aside id="provider-prerequisite" class="mt-6 rounded-xl border border-accent/30 bg-accent/10 p-5" aria-labelledby="provider-prerequisite-title">
    <h2 id="provider-prerequisite-title" class="font-semibold text-text-primary">{t('download.providerTitle')}</h2>
    <p class="mt-2 text-sm leading-6 text-text-secondary">
      {providerPrerequisite.disclosure[locale]}
      <a href={providerSetupUrl} class="ml-1 font-semibold text-accent underline underline-offset-2 hover:text-accent-hover">{t('download.providerSetup')}</a>
    </p>
  </aside>

  <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-border pt-5 text-sm text-text-secondary">
    <a
      href={releasesUrl}
      data-analytics-event="release_download_click"
      data-analytics-locale={locale}
      data-analytics-location="download_all_releases"
      data-analytics-platform="all"
      data-analytics-stage="github_releases"
      class="inline-flex min-h-11 items-center gap-1 font-semibold no-underline hover:text-accent"
    >
      {t('download.allReleases')}
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" /></svg>
    </a>
    <a
      href={releasesUrl}
      data-analytics-event="release_download_click"
      data-analytics-locale={locale}
      data-analytics-location="download_release_notes"
      data-analytics-platform="all"
      data-analytics-stage="github_releases"
      class="inline-flex min-h-11 items-center font-semibold no-underline hover:text-accent"
    >{t('download.releaseNotes')}</a>
  </div>

  <script is:inline>
    (function () {
      function detectPlatform(userAgent, uaDataPlatform) {
        if (/android|iphone|ipad|ipod/.test(userAgent)) return null;
        const signal = `${uaDataPlatform} ${userAgent}`;
        if (/windows|win64|win32/.test(signal)) return 'windows';
        if (/macintosh|mac os|macintel/.test(signal)) return 'macos';
        if (/linux|x11|cros/.test(signal)) return 'linux';
        return null;
      }

      const uaDataPlatform = navigator.userAgentData?.platform?.toLowerCase?.() || '';
      const userAgent = navigator.userAgent.toLowerCase();
      const likelyPlatform = detectPlatform(userAgent, uaDataPlatform);
      if (!likelyPlatform) return;
      const card = document.querySelector(`[data-platform-card="${likelyPlatform}"]`);
      if (!card) return;
      card.dataset.recommended = 'true';
      card.classList.add('border-accent', 'ring-2', 'ring-accent/20');
      card.querySelector('[data-platform-recommended]')?.classList.remove('hidden');
    })();
  </script>
</section>
