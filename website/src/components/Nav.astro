---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang, type UIKey } from '../i18n/utils.js';
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';

const locale = (Astro.currentLocale ?? 'zh') as Lang;
const t = useTranslations(locale);
const navigationLabel = locale === 'zh' ? '主导航' : 'Primary navigation';
const themeLabel = locale === 'zh' ? '切换明暗主题' : 'Toggle light or dark theme';

const navItems = [
  { key: 'nav.home', href: getRelativeLocaleUrl(locale, '/') },
  { key: 'nav.features', href: getRelativeLocaleUrl(locale, '/features/') },
  { key: 'nav.usage', href: getRelativeLocaleUrl(locale, '/usage/') },
  { key: 'nav.download', href: getRelativeLocaleUrl(locale, '/download/') },
  { key: 'nav.about', href: getRelativeLocaleUrl(locale, '/about/') },
  { key: 'nav.faq', href: getRelativeLocaleUrl(locale, '/faq/') },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href.replace(/\/$/, ''));
}
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a
      href={getRelativeLocaleUrl(locale, '/')}
      class="flex items-center gap-2 text-lg font-semibold text-text-primary no-underline hover:text-text-primary"
    >
      <BrandLogo />
      <span>Comate</span>
    </a>

    <nav aria-label={navigationLabel} class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-analytics-event={item.key === 'nav.download' ? 'download_cta_click' : undefined}
            data-analytics-locale={item.key === 'nav.download' ? locale : undefined}
            data-analytics-location={item.key === 'nav.download' ? 'nav_menu' : undefined}
            data-analytics-platform={item.key === 'nav.download' ? 'all' : undefined}
            data-analytics-stage={item.key === 'nav.download' ? 'download_page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors duration-200',
              isActive(item.href)
                ? 'bg-accent/10 text-accent'
                : 'text-text-secondary hover:bg-surface-hover hover:text-text-primary',
            ]}
          >
            {t(item.key as UIKey)}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <ThemeToggle label={themeLabel} />
      <slot name="language-picker" />
      <a
        href={getRelativeLocaleUrl(locale, '/download/')}
        data-analytics-event="download_cta_click"
        data-analytics-locale={locale}
        data-analytics-location="nav_primary"
        data-analytics-platform="all"
        data-analytics-stage="download_page"
        class="ml-2 inline-flex min-h-9 items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground no-underline hover:bg-accent-hover"
      >
        {t('nav.downloadCta')}
      </a>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <slot name="language-picker-mobile" />
      <MobileNav items={navItems} />
    </div>
  </div>
</header>
