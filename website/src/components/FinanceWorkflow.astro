---
import type { Lang } from '../i18n/utils.js';
import { financeScenarioStages } from '../lib/site-facts.js';

interface Props { locale: Lang }
const { locale } = Astro.props;

---

<section class="border-y border-border bg-surface/60" aria-labelledby="finance-workflow-heading" data-finance-workflow>
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-semibold uppercase tracking-wider text-accent">
        {locale === 'zh' ? '一个真实的异步任务' : 'A realistic asynchronous task'}
      </p>
      <h2 id="finance-workflow-heading" class="mt-3 text-3xl font-bold tracking-tight text-text-primary md:text-4xl">
        {locale === 'zh' ? '从一条 IM 消息，到一份可交付的财务报告' : 'From one IM message to a delivered finance report'}
      </h2>
      <p class="mt-5 text-lg leading-8 text-text-secondary">
        {locale === 'zh'
          ? '任务不需要占住聊天窗口。Comate 先确认，再在批准的边界内后台执行；需要你时暂停，完成后主动通知。'
          : 'The task does not need to occupy the chat window. Comate acknowledges first, works in the background within approved boundaries, pauses when you are needed, and notifies you when it is done.'}
      </p>
    </div>

    <ol class="mt-10 grid gap-4 md:grid-cols-2" aria-label={locale === 'zh' ? '财务报告任务流程' : 'Finance report task flow'}>
      {financeScenarioStages.map((stage, index) => (
        <li class:list={["relative rounded-xl border border-border bg-bg p-5", index === financeScenarioStages.length - 1 && "md:col-span-2"]} data-finance-stage={stage.key}>
          <div class="flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/40 bg-surface font-mono text-xs font-semibold text-accent" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-semibold text-text-primary">{stage.label[locale]}</h3>
              <p class="mt-2 text-sm leading-6 text-text-secondary">{stage.detail[locale]}</p>
              {'status' in stage && (
                <p class="mt-3 inline-flex rounded-md bg-surface px-2.5 py-1 font-mono text-xs text-text-tertiary">
                  {stage.status[locale]}
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
