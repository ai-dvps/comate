---
import type { Lang } from '../i18n/utils.js';

interface Props { locale: Lang }
const { locale } = Astro.props;
const copy = locale === 'zh'
  ? { workspace: '季度运营复盘', request: '汇总销售、费用与客户反馈，整理本季度运营复盘。', ack: '任务 OPS-128 已创建。我会在后台推进，需要确认时通知你。', status: '后台执行中', steps: ['连接已批准的数据源', '整理事实与异常项', '生成复盘报告'], footer: '你可以离开此会话；状态会持续更新', caption: '任务请求、执行进度和需要你处理的事项，都在一个 Workspace 中。' }
  : { workspace: 'Quarterly operations review', request: 'Combine sales, costs, and customer feedback into our quarterly operations review.', ack: 'Task OPS-128 is created. I will work in the background and notify you when input is needed.', status: 'Working in background', steps: ['Connect approved data sources', 'Organize facts and anomalies', 'Draft the review report'], footer: 'You can leave this Session; status will keep updating', caption: 'Task requests, execution progress, and items needing your attention stay in one Workspace.' };
---

<figure class="relative mx-auto w-full max-w-xl">
  <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-2xl shadow-black/10 dark:shadow-black/30">
    <div class="flex items-center justify-between border-b border-border bg-bg/70 px-4 py-3">
      <div class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span><span class="text-sm font-semibold text-text-primary">{copy.workspace}</span></div>
      <span class="font-mono text-xs text-text-tertiary">Workspace</span>
    </div>
    <div class="space-y-5 p-5 sm:p-6">
      <div class="ml-auto max-w-[88%] rounded-2xl rounded-br-sm bg-text-primary px-4 py-3 text-sm leading-6 text-bg">{copy.request}</div>
      <div class="max-w-[92%] rounded-2xl rounded-bl-sm border border-border bg-bg px-4 py-3 text-sm leading-6 text-text-primary">{copy.ack}</div>
      <section class="rounded-xl border border-border bg-bg/60 p-4" aria-label={copy.status}>
        <div class="flex items-center justify-between gap-4"><p class="font-mono text-xs font-semibold uppercase tracking-wide text-accent">OPS-128</p><p class="flex items-center gap-2 text-xs text-text-secondary"><span class="h-2 w-2 rounded-full bg-warning" aria-hidden="true"></span>{copy.status}</p></div>
        <ol class="mt-4 space-y-3">
          {copy.steps.map((step, index) => <li class="flex items-center gap-3 text-sm text-text-secondary"><span class:list={["h-1.5 w-1.5 rounded-full", index === 0 ? "bg-success" : index === 1 ? "bg-accent" : "bg-border-hover"]} aria-hidden="true"></span><span>{step}</span></li>)}
        </ol>
      </section>
      <p class="border-t border-border pt-4 text-center text-xs text-text-tertiary">{copy.footer}</p>
    </div>
  </div>
  <figcaption class="mt-4 text-center text-sm leading-6 text-text-tertiary">{copy.caption}</figcaption>
</figure>
