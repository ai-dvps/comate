    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.7.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.4",
    "@comate/api-contracts": "workspace:*",
    "@larksuite/vercel-chat-adapter": "^0.1.2",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@openai/codex": "0.149.0",
    "@opencode-ai/sdk": "1.18.23",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@radix-ui/react-use-controllable-state": "^1.1.0",
    "@uiw/react-codemirror": "^4.22.2",
    "@vscode/ripgrep": "^1.18.0",
    "@webank/wecom": "workspace:*",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "adm-zip": "^0.6.0",
    "ai": "^6.0.208",
    "better-sqlite3": "^12.10.0",
    "chat": "^4.31.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.11",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fdir": "^6.5.0",
    "fuzzysort": "^3.1.0",
    "get-east-asian-width": "^1.6.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "ignore": "^7.0.5",
    "is-glob": "^4.0.3",
    "lucide-react": "^0.400.0",
    "picomatch": "^4.0.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "shiki": "^1.0.0",
    "streamdown": "^1.0.0",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^2.0.0",
    "tldts": "^7.4.9",
    "use-stick-to-bottom": "^1.0.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/is-glob": "^4.0.4",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@yao-pkg/pkg": "^6.19.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "43.3.0",
    "electron-builder": "26.12.1",
    "electron-updater": "6.8.9",
    "electron-vite": "5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^25.0.1",
    "playwright": "^1.55.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.11.2",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "axios": "^1.18.1",
    "@yao-pkg/pkg": {
      "esbuild": "^0.28.1"
    },
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "js-yaml": "^4.1.2",
    "qs": "^6.15.3",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.16",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.149.0-darwin-arm64",
    "@openai/codex-darwin-x64": "npm:@openai/codex@0.149.0-darwin-x64",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.149.0-linux-arm64",
    "@openai/codex-linux-x64": "npm:@openai/codex@0.149.0-linux-x64",
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.149.0-win32-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.149.0-win32-x64",
    "opencode-darwin-arm64": "1.18.23",
    "opencode-darwin-x64": "1.18.23",
    "opencode-linux-arm64": "1.18.23",
    "opencode-linux-arm64-musl": "1.18.23",
    "opencode-linux-x64": "1.18.23",
    "opencode-linux-x64-musl": "1.18.23",
    "opencode-windows-x64": "1.18.23"
  }
}
