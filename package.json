{
  "name": "comate",
  "version": "0.4.5",
  "description": "Your friendly AI workspace companion",
  "author": "ai-dvps",
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run build:contracts && tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:contracts && tsc -b && npm run build:client && npm run build:cli:packages",
    "build:contracts": "npm run build -w packages/comate-api-contracts",
    "build:server": "npm run build:contracts && tsc -p tsconfig.server.json",
    "build:cli": "npm run build:contracts && npm run build:cli:packages",
    "build:cli:packages": "npm run build:cli:wecom && npm run build:cli:comate",
    "build:cli:wecom": "npm run build -w packages/wecom-cli",
    "build:cli:comate": "npm run build -w packages/comate-cli",
    "build:sidecar": "tsx scripts/build-sidecar.ts && npm run test:sidecar-new-chat",
    "generate:codex-protocol": "tsx scripts/generate-codex-protocol.ts",
    "test:codex-protocol": "tsx --test scripts/codex-protocol-drift.test.ts",
    "verify:codex-app-server": "tsx scripts/verify-codex-app-server.ts",
    "verify:codex-release-gates": "npm run test:codex-protocol && npm run verify:codex-app-server && npm run test:sidecar-new-chat",
    "start": "node dist/server/index.js",
    "test": "npm run test:server && npm run test:client && npm run test:electron && npm run test:scripts && npm run test:packages",
    "test:client": "vitest run --project jsdom",
    "test:client:watch": "vitest --project jsdom",
    "test:browser": "vitest run --project browser",
    "test:shell-cdp": "tsx scripts/test-shell-cdp.ts",
    "test:shell-cdp:required": "tsx scripts/test-shell-cdp.ts --required",
    "test:electron-cdp": "tsx scripts/test-electron-cdp.ts",
    "test:electron-cdp:required": "tsx scripts/test-electron-cdp.ts --required",
    "test:browser-acceptance:deterministic": "tsx --test src/server/services/__tests__/browser-task-trace.test.ts src/server/services/browser-mcp-http.test.ts scripts/evaluate-browser-task.test.ts scripts/fixtures/dynamic-publishing-task-fixture.test.ts scripts/browser-production-neutrality.test.ts",
    "test:server": "npm run build:contracts && tsx scripts/test-server.ts",
    "test:scripts": "tsx --test scripts/electron-build-contract.test.ts scripts/readme-contract.test.ts scripts/patch-electron-dev-name.test.ts scripts/verify-packaged-renderer.test.ts scripts/test-server.test.ts scripts/lib/process-cleanup.test.ts scripts/lib/sidecar-node-version.test.ts scripts/evaluate-browser-task.test.ts scripts/fixtures/dynamic-publishing-task-fixture.test.ts scripts/browser-production-neutrality.test.ts scripts/codex-protocol-drift.test.ts scripts/sync-gitee.test.ts",
    "test:packages": "npm run build:cli && npm test -w packages/comate-api-contracts -w packages/comate-cli -w packages/wecom-cli",
    "typecheck": "npm run build:contracts && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "dev:electron": "npm run patch:electron-dev-name && npm run build:sidecar && concurrently --kill-others --success first \"npm run dev:client\" \"electron-vite dev\"",
    "patch:electron-dev-name": "node scripts/patch-electron-dev-name.mjs",
    "postinstall": "node scripts/patch-electron-dev-name.mjs",
    "build:client": "vite build",
    "build:electron:shell": "electron-vite build",
    "build:electron": "npm run build:client && npm run build:electron:shell",
    "dist:electron": "npm run build:electron && electron-builder --config electron-builder.config.ts",
    "test:electron": "tsx --test electron/*.test.ts",
    "test:electron:build": "tsx --test scripts/electron-build-contract.test.ts scripts/verify-packaged-renderer.test.ts",
    "test:electron-build": "npm run test:electron:build",
    "test:sidecar-new-chat": "tsx --test scripts/sidecar-new-chat-smoke.test.ts",
    "verify:electron:package": "tsx scripts/verify-packaged-renderer.ts",
    "verify:electron-package": "npm run verify:electron:package",
    "verify:electron:mac-signature": "tsx scripts/verify-packaged-macos-signature.ts",
    "release": "npm run typecheck && npm run test:browser-acceptance:deterministic && npm run build:sidecar && npm run test:shell-cdp:required && npm run test:electron-cdp:required && npm run dist:electron && npm run verify:electron:mac-signature"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@chat-adapter/state-memory": "^4.31.0",
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
